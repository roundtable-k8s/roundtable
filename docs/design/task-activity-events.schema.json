{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roundtable.io/schemas/task-activity-event.v1.json",
  "title": "TaskActivityEvent",
  "type": "object",
  "required": ["v", "type", "ts", "knight", "pod", "taskId", "seq"],
  "properties": {
    "v": {"const": 1},
    "type": {"enum": ["task.started", "task.heartbeat", "tool.started", "tool.finished", "assistant.message", "task.finished"]},
    "ts": {"type": "string", "format": "date-time"},
    "knight": {"type": "string"},
    "pod": {"type": "string"},
    "node": {"type": "string"},
    "taskId": {"type": "string"},
    "runId": {"type": "string"},
    "chainName": {"type": "string"},
    "stepName": {"type": "string"},
    "model": {"type": "string"},
    "seq": {"type": "integer", "minimum": 1},
    "truncated": {"type": "boolean"},
    "slot": {"type": "integer", "minimum": 0},
    "concurrency": {"type": "integer", "minimum": 1},
    "queuedFor": {"type": "integer", "minimum": 0},
    "turns": {"type": "integer", "minimum": 0},
    "inputTokens": {"type": "integer", "minimum": 0},
    "outputTokens": {"type": "integer", "minimum": 0},
    "costUsd": {"type": "number", "minimum": 0},
    "currentTool": {"type": "string"},
    "tool": {"type": "string"},
    "toolCallId": {"type": "string"},
    "argsSummary": {"type": "string", "maxLength": 200},
    "durationMs": {"type": "integer", "minimum": 0},
    "isError": {"type": "boolean"},
    "outputPreview": {"type": "string", "maxLength": 500},
    "preview": {"type": "string", "maxLength": 500},
    "success": {"type": "boolean"},
    "errorClass": {"type": "string"}
  },
  "additionalProperties": true
}
